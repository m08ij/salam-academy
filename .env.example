# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Public HTTPS address of the platform (must match what users type; used for e-mail links and the Origin check)
SALAM_APP_URL=https://academy.example.org
# Generate with:  docker compose run --rm api python -m app.cli gen-key   (keep it secret and backed up — it decrypts 2FA secrets)
SALAM_MFA_ENCRYPTION_KEY=
SALAM_ENVIRONMENT=production
SALAM_COOKIE_SECURE=true
SALAM_REQUIRE_STAFF_MFA=true
SALAM_ALLOW_SIGNUP=false
# Trial period: only these e-mails can sign in or be invited (comma-separated). Leave empty to open the platform.
SALAM_TRIAL_EMAILS=
SALAM_HIBP_CHECK=false
SALAM_SMTP_HOST=smtp.example.org
SALAM_SMTP_PORT=587
SALAM_SMTP_USER=
SALAM_SMTP_PASSWORD=
SALAM_SMTP_FROM=Salam Academy <no-reply@example.org>
