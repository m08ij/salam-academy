<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_bg" android:layoutDirection="ltr">
    <View android:id="@+id/v_bar" android:layout_width="5dp" android:layout_height="match_parent" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" android:layout_marginStart="10dp" android:background="#FF0B7F7A" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/v_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FF7A8E90" android:textStyle="bold" android:gravity="start" />
                <TextView android:id="@+id/v_relation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FF0B7F7A" android:gravity="start" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/v_next" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="&#x27F3;" android:textSize="17sp" android:textColor="#FF0A5C66" android:background="@drawable/widget_round_btn" android:contentDescription="@string/widget_next" />
        </LinearLayout>
        <TextView android:id="@+id/v_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="19sp" android:textStyle="bold" android:textColor="#FF0F2427" android:gravity="start" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/v_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:textColor="#FF4A5F62" android:gravity="start" android:maxLines="3" android:ellipsize="end" />
        <TextView android:id="@+id/v_behavior" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="#FF0A5C66" android:textStyle="italic" android:gravity="start" android:maxLines="3" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
